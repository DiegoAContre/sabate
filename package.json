{
  "name": "sabate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api -c blue \"npm run dev -w apps/api\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:push": "npm run db:push -w packages/db",
    "db:studio": "npm run db:studio -w packages/db"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.0"
  }
}
