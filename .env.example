# Environment variables — copy the relevant blocks into each app\'s own .env file

# ------------------------------------------------------------------
# apps/api/.env
# ------------------------------------------------------------------
PORT=3001
JWT_SECRET=change-me-at-least-32-characters-long
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://sabate:sabate@localhost:5432/sabate

# Required for npm run seed
SEED_ADMIN_EMAIL=admin@sabate.com
SEED_ADMIN_PASSWORD=change-me-min-8-chars

# Optional — 503 if missing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — 503 if missing
S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ------------------------------------------------------------------
# apps/web/.env.local
# ------------------------------------------------------------------
AUTH_SECRET=...
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------
# packages/db/.env
# ------------------------------------------------------------------
DATABASE_URL=postgres://sabate:sabate@localhost:5432/sabate
