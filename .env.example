# apps/pos/.env — cópialo a apps/pos/.env (no se versiona)

# Secreto para firmar el JWT de sesión (mínimo 32 caracteres; `openssl rand -hex 32`).
AUTH_SECRET=change-me-at-least-32-characters-long

# Ruta de la SQLite (por defecto ./data/pos.db).
SQLITE_PATH=./data/pos.db

# Dueño inicial para `npm run seed` (contraseña mínima de 8 caracteres).
SEED_OWNER_USERNAME=admin
SEED_OWNER_PASSWORD=change-me-min-8-chars

# Respaldo (opcional): carpeta de las copias y token para el cron / deploy.sh.
BACKUP_DIR=./data/backups
BACKUP_TOKEN=
